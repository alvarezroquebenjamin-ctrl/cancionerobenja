<!--TOOLS.JS-->
/* ===================================================
   LÓGICA MUSICAL INLINE (Web Audio API)
   =================================================== */

document.addEventListener('DOMContentLoaded', () => {
    let audioCtx = null;
    function initAudio() {
        if (!audioCtx) {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
    }

    // =========================================
    // 1. MINI AFINADOR
    // =========================================
    let currentOscillator = null;
    const noteFrequencies = {
        'E2': 82.41, 'A2': 110.00, 'D3': 146.83,
        'G3': 196.00, 'B3': 246.94, 'E4': 329.63
    };

    function playNote(frequency, btnElement) {
        initAudio();
        stopNote(); // Frena la nota anterior si tocás rápido otra

        currentOscillator = audioCtx.createOscillator();
        currentOscillator.type = 'triangle'; // Mejor sonido para graves
        currentOscillator.frequency.setValueAtTime(frequency, audioCtx.currentTime);

        const gainNode = audioCtx.createGain();
        gainNode.gain.setValueAtTime(0.5, audioCtx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 3); // Suena 3 segundos

        currentOscillator.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        currentOscillator.start();
        currentOscillator.stop(audioCtx.currentTime + 3);

        // Efecto visual de botón apretado
        document.querySelectorAll('.btn-nota-inline').forEach(b => b.classList.remove('active'));
        btnElement.classList.add('active');

        setTimeout(() => {
            btnElement.classList.remove('active');
        }, 3000);
    }

    function stopNote() {
        if (currentOscillator) {
            currentOscillator.stop();
            currentOscillator = null;
        }
    }

    document.querySelectorAll('.btn-nota-inline').forEach(btn => {
        btn.addEventListener('click', function() {
            playNote(noteFrequencies[this.dataset.nota], this);
        });
    });

    // =========================================
    // 2. MINI METRÓNOMO
    // =========================================
    let isMetronomeRunning = false;
    let metronomeInterval = null;
    let currentBpm = 120;

    const bpmDisplay = document.getElementById('bpmDisplayInline');
    const bpmMas = document.getElementById('bpmMasInline');
    const bpmMenos = document.getElementById('bpmMenosInline');
    const startMetronomoBtn = document.getElementById('startMetronomoInline');

    function playClick() {
        initAudio();
        const osc = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();

        osc.type = 'square';
        osc.frequency.setValueAtTime(800, audioCtx.currentTime); 
        
        gainNode.gain.setValueAtTime(1, audioCtx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.05);
        
        osc.connect(gainNode);
        gainNode.connect(audioCtx.destination);
        
        osc.start();
        osc.stop(audioCtx.currentTime + 0.05);
    }

    function updateBpm(newBpm) {
        currentBpm = Math.max(40, Math.min(220, newBpm));
        bpmDisplay.textContent = currentBpm;
        
        // Si ya está sonando, reinicia el tempo al vuelo
        if (isMetronomeRunning) {
            stopMetronome();
            startMetronome();
        }
    }

    function startMetronome() {
        initAudio();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const intervalMs = (60 / currentBpm) * 1000;
        playClick(); // Primer click
        metronomeInterval = setInterval(playClick, intervalMs);
        
        // Cambia el ícono a Stop y color rojo
        startMetronomoBtn.innerHTML = '<i class="fas fa-stop" style="font-size: 12px;"></i>';
        startMetronomoBtn.classList.replace('btn-primary', 'btn-danger');
        isMetronomeRunning = true;
    }

    function stopMetronome() {
        clearInterval(metronomeInterval);
        metronomeInterval = null;
        
        // Vuelve a ícono de Play y color principal
        startMetronomoBtn.innerHTML = '<i class="fas fa-play" style="font-size: 12px;"></i>';
        startMetronomoBtn.classList.replace('btn-danger', 'btn-primary');
        isMetronomeRunning = false;
    }

    bpmMas.addEventListener('click', () => updateBpm(parseInt(currentBpm) + 1));
    bpmMenos.addEventListener('click', () => updateBpm(parseInt(currentBpm) - 1));

    startMetronomoBtn.addEventListener('click', () => {
        isMetronomeRunning ? stopMetronome() : startMetronome();
    });
});